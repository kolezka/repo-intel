#!/usr/bin/env bash
# repo-intel: set up, build and inspect codegraph + graphify for one repository.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: repo-intel <command> [options]

  doctor                     Report tools, config, graphs and duplicate global hooks
  install [graphify|codegraph|all]
                             Install or upgrade to latest (graphify via uv/pipx, codegraph via pnpm/npm)
  setup                      In the current git repo: index codegraph, add .gitignore
                             entries, install graphify git hooks, then build
  config [--global] --backend B [--model M] [--base-url URL]
                             Choose the LLM backend for graphify semantic extraction.
                             B: a graphify provider (see `graphify provider list`),
                             ollama, openai, claude, gemini, deepseek, kimi,
                             code-only (no LLM), or agent (current agent CLI subagents)
  config --show              Print the effective config
  build [--full] [--strict]
                             Refresh codegraph and graphify using the configured backend.
                             --strict fails the build if graphify could not fully parse
                             every file (see the partial-parse warning)
  instructions [--remove]    Write (or remove) a short managed block in CLAUDE.md
                             and AGENTS.md pointing any agent, with or without this
                             plugin, at codegraph/graphify. Needs .codegraph/ and/or
                             graphify-out/graph.json to already exist
  migrate-hooks [--apply]    Remove the global `graphify hook-guard` and
                             `codegraph prompt-hook` entries this plugin replaces
                             (dry run unless --apply; backs up settings.json)
EOF
}

die() { printf 'repo-intel: %s\n' "$*" >&2; exit 1; }
info() { printf 'repo-intel: %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"; }
user_config() { printf '%s/repo-intel/config.json' "${XDG_CONFIG_HOME:-$HOME/.config}"; }
settings_file() { printf '%s/settings.json' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; }

# Sets BACKEND, MODEL and BASE_URL from one source, same rule as the hook:
# env, else the first config file that names a backend (repo root, then user).
resolve_llm() {
  local root=${1:-} f
  BACKEND="" MODEL="" BASE_URL=""
  if [[ -n ${REPO_INTEL_BACKEND:-} ]]; then
    BACKEND=$REPO_INTEL_BACKEND MODEL=${REPO_INTEL_MODEL:-}
    return 0
  fi
  for f in ${root:+"$root/.repo-intel.json"} "$(user_config)"; do
    [[ -f $f ]] || continue
    jq -e . "$f" >/dev/null 2>&1 || die "$f is not valid JSON"
    BACKEND=$(jq -r '.llm.backend // empty' "$f")
    if [[ -n $BACKEND ]]; then
      MODEL=${REPO_INTEL_MODEL:-$(jq -r '.llm.model // empty' "$f")}
      BASE_URL=$(jq -r '.llm.base_url // empty' "$f")
      return 0
    fi
  done
  return 0
}

# Hook commands this plugin replaces, bare or path-qualified (npx, uvx, /abs/path).
replaced_hooks='(^|[/[:space:]])graphify hook-guard|(^|[/[:space:]])codegraph prompt-hook'

cmd_doctor() {
  local ok=0 root settings dup t
  for t in jq git graphify codegraph; do
    if have "$t"; then
      printf '  %-15s %s\n' "$t" "$("$t" --version 2>/dev/null | head -1)"
    else
      printf '  %-15s MISSING\n' "$t"; ok=1
    fi
  done
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -n $root ]]; then
    local has_cg=0 has_gf=0
    printf '  %-15s %s\n' repo "$root"
    if [[ -d $root/.codegraph ]]; then printf '  %-15s present\n' codegraph-index; has_cg=1
    else printf '  %-15s none (run: repo-intel setup)\n' codegraph-index; fi
    if [[ -f $root/graphify-out/graph.json ]]; then printf '  %-15s present\n' graphify-graph; has_gf=1
    else printf '  %-15s none (run: repo-intel build)\n' graphify-graph; fi
    instructions_status "$root" "$has_cg" "$has_gf"
    printf '  %-15s %s\n' instructions "$INSTR_STATUS"
  fi
  resolve_llm "$root"
  printf '  %-15s %s\n' backend "${BACKEND:-unset (build indexes code only)}${MODEL:+ / $MODEL}"
  settings=$(settings_file)
  if [[ -f $settings ]]; then
    dup=$(jq -r --arg re "$replaced_hooks" '[.hooks // {} | .[][]? | .hooks[]?.command // empty
      | select(test($re))] | unique | join(", ")' "$settings")
    [[ -n $dup ]] && printf '  %-15s duplicate global hooks: %s (run: repo-intel migrate-hooks)\n' hooks "$dup"
  fi
  return $ok
}

cmd_install() {
  local what=${1:-all} v
  if [[ $what == all || $what == graphify ]]; then
    # uv resolves `pkg@latest` to the newest release and reinstalls over
    # whatever is there, so no separate --upgrade/--force is needed.
    if have uv; then uv tool install graphifyy@latest
    # pipx has no @latest; `install` on an already-managed venv errors, so
    # upgrade it instead. `have graphify` alone is not enough: brew, uv or a
    # manual install can put graphify on PATH without pipx managing it, and
    # `pipx upgrade` on a package pipx never installed fails with "not
    # installed". Ask pipx directly.
    elif have pipx; then
      if pipx list --short 2>/dev/null | awk '$1 == "graphifyy" { f = 1 } END { exit !f }'; then
        pipx upgrade graphifyy
      else pipx install graphifyy; fi
    else die "need uv or pipx to install graphify (package: graphifyy)"; fi
    if have graphify; then
      v=$(graphify --version 2>/dev/null || true)
      [[ -n $v ]] && info "graphify: $v"
    fi
  fi
  if [[ $what == all || $what == codegraph ]]; then
    # An explicit @latest always resolves and installs that version, whether
    # codegraph is new or already on PATH, so this covers install and upgrade.
    if have pnpm; then pnpm add -g @colbymchenry/codegraph@latest
    elif have npm; then npm install -g @colbymchenry/codegraph@latest
    else die "need pnpm or npm to install codegraph"; fi
    if have codegraph; then
      v=$(codegraph --version 2>/dev/null || true)
      [[ -n $v ]] && info "codegraph: $v"
    fi
  fi
  have jq || info "jq is missing; the hooks stay silent without it (brew install jq)"
}

ensure_gitignore() {
  local root=$1 entry
  for entry in .codegraph/ graphify-out/cache/; do
    grep -qxF "$entry" "$root/.gitignore" 2>/dev/null || printf '%s\n' "$entry" >> "$root/.gitignore"
  done
}

# graphify parses .svelte with the JS grammar and extracts nothing useful from it;
# codegraph already handles Svelte correctly, so keep graphify off those files.
ensure_graphifyignore() {
  local root=$1 entry='*.svelte'
  # No pipe to grep here: with many tracked files, git's output can exceed the
  # pipe buffer and SIGPIPE it once grep -q exits early, which pipefail turns
  # into a false "no matches" and silently skips the ignore entry.
  [[ -n $(git -C "$root" ls-files -- "$entry" 2>/dev/null) ]] || return 0
  grep -qxF "$entry" "$root/.graphifyignore" 2>/dev/null || {
    printf '%s\n' "$entry" >> "$root/.graphifyignore"
    info "added $entry to .graphifyignore (graphify cannot parse Svelte; codegraph covers it)"
  }
}

cmd_setup() {
  local root; root=$(repo_root)
  have codegraph || die "codegraph missing (run: repo-intel install)"
  have graphify || die "graphify missing (run: repo-intel install)"
  ensure_gitignore "$root"
  [[ -d $root/.codegraph ]] || (cd "$root" && codegraph init -y)
  (cd "$root" && graphify hook install)
  cmd_build
  cmd_instructions
}

cmd_config() {
  local global=0 show=0 backend="" model="" base_url="" target root
  while [[ $# -gt 0 ]]; do
    case $1 in
      --global) global=1 ;;
      --show) show=1 ;;
      --backend) backend=${2:?--backend needs a value}; shift ;;
      --model) model=${2:?--model needs a value}; shift ;;
      --base-url) base_url=${2:?--base-url needs a value}; shift ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [[ $show == 1 ]]; then
    resolve_llm "$root"
    printf 'backend=%s model=%s base_url=%s\n' "$BACKEND" "$MODEL" "$BASE_URL"
    return
  fi
  [[ -n $backend ]] || die "config needs --backend (or --show)"
  if [[ -n $base_url ]]; then
    case $backend in
      openai|claude|ollama) ;;
      *) die "--base-url only applies to openai, claude and ollama; a graphify provider keeps its URL in ~/.graphify/providers.json" ;;
    esac
  fi
  if [[ $global == 1 ]]; then
    target=$(user_config); mkdir -p "$(dirname "$target")"
  else
    [[ -n $root ]] || die "not in a git repo; use --global"
    target=$root/.repo-intel.json
  fi
  # Only names and URLs go in the file; API keys stay in the environment.
  jq -n --arg b "$backend" --arg m "$model" --arg u "$base_url" \
    '{llm: ({backend: $b} + (if $m != "" then {model: $m} else {} end) + (if $u != "" then {base_url: $u} else {} end))}' \
    > "$target.tmp" && mv "$target.tmp" "$target"
  info "wrote $target"
}

# Matches graphify's stderr warning about files it could only partly parse.
# Depends on graphify's wording; tests/run.sh checks it against the real binary.
partial_parse_pattern='[0-9]+ file\(s\) had syntax errors'

# Streams graphify stderr live, keeps a copy to count partial parses into
# GRAPHIFY_PARTIAL_COUNT. pipefail still carries a failing extract's exit code.
run_graphify_extract() {
  local root=$1 tmp line; shift
  tmp=$(mktemp) || die "could not create a temp file for graphify's stderr"
  trap 'rm -f "$tmp"' EXIT
  { (cd "$root" && graphify extract . "$@") 2>&1 1>&3 | tee "$tmp" >&2; } 3>&1
  GRAPHIFY_PARTIAL_COUNT=0
  line=$(grep -oE "$partial_parse_pattern" "$tmp" 2>/dev/null | head -1) || true
  [[ -n $line ]] && GRAPHIFY_PARTIAL_COUNT=${line%% *}
  rm -f "$tmp"
  trap - EXIT
}

cmd_build() {
  local root backend model base_url args=() full=0 strict=0 code_only=0 opt
  for opt in "$@"; do
    case $opt in
      --full) full=1 ;;
      --strict) strict=1 ;;
      *) printf 'repo-intel: build: unknown option: %s\n' "$opt" >&2; usage; exit 1 ;;
    esac
  done
  [[ $full == 1 ]] && args+=(--force)
  root=$(repo_root)
  resolve_llm "$root"
  backend=$BACKEND model=$MODEL base_url=$BASE_URL

  if have codegraph; then
    if [[ -d $root/.codegraph ]]; then (cd "$root" && codegraph sync); else (cd "$root" && codegraph init -y); fi
  else
    info "codegraph missing, skipped"
  fi

  have graphify || die "graphify missing (run: repo-intel install)"
  ensure_graphifyignore "$root"
  case ${backend:-code-only} in
    agent)
      info "backend=agent: code structure only here; run /graphify in your agent CLI for docs"
      args+=(--code-only); code_only=1 ;;
    code-only)
      [[ -z $backend ]] && info "no backend configured, indexing code only (set one: repo-intel config --backend <name>)"
      args+=(--code-only); code_only=1 ;;
    *)
      [[ $backend == ollama ]] && args+=(--max-concurrency 1)
      args+=(--backend "$backend")
      [[ -n $model ]] && args+=(--model "$model")
      # Point the stock clients at a self-hosted endpoint when one is configured.
      if [[ -n $base_url ]]; then
        case $backend in
          openai) export OPENAI_BASE_URL=$base_url; [[ -n $model ]] && export OPENAI_MODEL=$model ;;
          claude) export ANTHROPIC_BASE_URL=$base_url; [[ -n $model ]] && export ANTHROPIC_MODEL=$model ;;
          ollama) export OLLAMA_HOST=$base_url ;;
        esac
      fi
      info "graphify extract on backend=$backend${model:+ model=$model}" ;;
  esac

  run_graphify_extract "$root" "${args[@]}"

  # Applies to every backend path: graphify can exit 0 while leaving no usable
  # graph (or a truncated one) behind it.
  [[ -f $root/graphify-out/graph.json ]] || die "graphify extract did not produce $root/graphify-out/graph.json"
  jq -e . "$root/graphify-out/graph.json" >/dev/null 2>&1 || die "$root/graphify-out/graph.json is not valid JSON"

  if [[ $GRAPHIFY_PARTIAL_COUNT -gt 0 ]]; then
    if [[ $strict == 1 ]]; then
      die "graphify: $GRAPHIFY_PARTIAL_COUNT file(s) could not be fully parsed (see warning above); failing due to --strict"
    fi
    info "graphify: $GRAPHIFY_PARTIAL_COUNT file(s) could not be fully parsed (see warning above)"
  fi

  [[ $code_only == 1 ]] && return
  # The session-start hook compares docs changed since this commit.
  mkdir -p "$root/graphify-out"
  git -C "$root" rev-parse HEAD > "$root/graphify-out/.repo-intel-built" 2>/dev/null || true
}

cmd_migrate_hooks() {
  local apply=0 settings backup found
  [[ ${1:-} == --apply ]] && apply=1
  settings=$(settings_file)
  [[ -f $settings ]] || { info "no $settings"; return 0; }
  # Edit the real file so a dotfiles symlink stays a symlink.
  settings=$(realpath "$settings")
  found=$(jq -r --arg re "$replaced_hooks" '[.hooks // {} | .[][]? | .hooks[]?.command // empty | select(test($re))] | .[]' "$settings")
  [[ -n $found ]] || { info "no duplicate global hooks"; return 0; }
  printf 'Global hooks replaced by repo-intel (in %s):\n%s\n' "$settings" "$found"
  grep -q 'hook-guard read' <<<"$found" && \
    info "note: hook-guard read (Read/Glob) is dropped, not replaced; repo-intel nudges on searches only"
  [[ $apply == 1 ]] || { info "dry run; re-run with --apply"; return 0; }
  backup="$settings.bak-repo-intel-$(date +%Y%m%d%H%M%S)"
  cp "$settings" "$backup"
  # Drop matching commands, then groups left empty, then events left empty.
  jq --arg re "$replaced_hooks" '.hooks |= (
      map_values(map(.hooks |= map(select((.command // "") | test($re) | not))) | map(select(.hooks | length > 0)))
      | with_entries(select(.value | length > 0)))' "$backup" > "$settings.tmp"
  mv "$settings.tmp" "$settings"
  info "removed; backup at $backup (undo: cp \"$backup\" \"$settings\")"
}

instr_begin='<!-- repo-intel:begin -->'
instr_end='<!-- repo-intel:end -->'
instr_cr=$'\r'

# Short "how to use the graphs" note for CLAUDE.md/AGENTS.md, written for an
# agent that does not have this plugin. Mirrors skills/route/SKILL.md. Returned
# with no trailing newline; callers add one.
instructions_block() { # has_codegraph(0/1) has_graphify(0/1)
  local cg=$1 gf=$2
  printf '%s\n' "$instr_begin"
  printf '## Code graphs\n'
  printf '\n'
  printf 'This repo is indexed for faster lookup. Use the right tool for the question.\n'
  if [[ $cg == 1 ]]; then
    printf '\n'
    printf 'Where is X defined, who calls it, what breaks if it changes: use codegraph.\n'
    printf 'The `codegraph_explore` MCP tool if available, else `codegraph explore\n'
    printf '"<symbols>"`, `codegraph impact X`, `codegraph affected <files>`.\n'
  fi
  if [[ $gf == 1 ]]; then
    printf '\n'
    printf 'Concepts, architecture, why something was decided: use graphify.\n'
    printf '`graphify query "<question>"`, `graphify explain X`, `graphify path "A" "B"`.\n'
  fi
  printf '\n'
  printf 'Literal text, config values, error strings, and every call site before calling\n'
  printf 'a change safe or code unused: use rg (or grep), not the graphs. They miss\n'
  printf 'dynamic dispatch, generated code and bodies wrapped in higher-order calls.\n'
  printf '\n'
  printf 'Refresh when stale: `repo-intel build` if installed, else `codegraph sync`\n'
  printf 'and `graphify update .`.\n'
  printf '%s\n' "$instr_end"
}

# Resolves $2 (CLAUDE.md or AGENTS.md under repo root $1, itself already
# realpath'd) through any symlink. Sets INSTR_TARGET to the real path to
# read/write (or the plain path if nothing exists yet there), and
# INSTR_TARGET_ERR to a message if $2 is a dangling symlink, or a symlink
# that resolves outside the repo. A dangling symlink is refused outright
# rather than partly resolved: a relative target can itself cross a
# symlinked directory, or an absolute target can embed "..", and a lexical
# resolution good enough to catch every such case is exactly the complexity
# realpath already handles correctly for anything that exists. Once a target
# is known to exist, realpath follows the whole chain, including symlinked
# ancestor directories, in one call.
instructions_safe_target() {
  local root=$1 path=$2 resolved
  INSTR_TARGET_ERR=""
  if [[ -L $path ]]; then
    if [[ ! -e $path ]]; then
      INSTR_TARGET_ERR="$path: dangling symlink"
      INSTR_TARGET=$path
      return 0
    fi
    resolved=$(realpath "$path")
    case $resolved in
      "$root"|"$root"/*) ;;
      *) INSTR_TARGET_ERR="$path: symlink points outside the repo root ($resolved)" ;;
    esac
    INSTR_TARGET=$resolved
    return 0
  fi
  if [[ -e $path ]]; then INSTR_TARGET=$(realpath "$path"); else INSTR_TARGET=$path; fi
}

# Resolves CLAUDE.md and AGENTS.md at the repo root through any symlink, so an
# edit lands on the real file and a symlink stays a symlink. Sets INSTR_CLAUDE,
# INSTR_AGENTS (real paths, or the plain path if the file does not exist yet),
# INSTR_SHARED (1 if both names resolve to the same file), and
# INSTR_CLAUDE_ERR/INSTR_AGENTS_ERR (a message if that name is a dangling
# symlink or one escaping the repo; callers decide whether that is fatal).
instructions_resolve() {
  local root; root=$(realpath "$1")
  instructions_safe_target "$root" "$root/CLAUDE.md"
  INSTR_CLAUDE=$INSTR_TARGET; INSTR_CLAUDE_ERR=$INSTR_TARGET_ERR
  instructions_safe_target "$root" "$root/AGENTS.md"
  INSTR_AGENTS=$INSTR_TARGET; INSTR_AGENTS_ERR=$INSTR_TARGET_ERR
  INSTR_SHARED=0; [[ $INSTR_CLAUDE == "$INSTR_AGENTS" ]] && INSTR_SHARED=1
  return 0
}

# True if $1 exists and has more than one hard link, e.g. because it is
# hardlinked to another file. `find -links` is a standard predicate on both
# BSD and GNU find, so this works without GNU stat.
instructions_hardlinked() {
  [[ -f $1 ]] && [[ -n $(find "$1" -links +1 2>/dev/null) ]]
}

# Dies if $1 exists but is not a readable, writable, singly-linked regular
# file. A missing path is fine, it gets created. Without the readable/
# writable checks, an unreadable file (e.g. chmod 200) silently reads as
# empty and gets overwritten. Without the hardlink check, replacing $1 (via
# instructions_commit's atomic rename) would detach it from whatever else
# shares its inode, silently un-sharing content the user may be relying on.
instructions_check_target() {
  local path=$1
  [[ -e $path ]] || return 0
  [[ -f $path ]] || die "$path: exists but is not a regular file"
  [[ -r $path ]] || die "$path: exists but is not readable"
  [[ -w $path ]] || die "$path: exists but is not writable"
  instructions_hardlinked "$path" && die "$path: is hardlinked to another file; use a symlink instead"
  return 0
}

# Single-pass locator for the managed block, shared by add/update/remove and
# doctor. Scans $1 for the begin/end markers (matched after stripping
# trailing spaces, tabs and \r) while ignoring anything inside a fenced code
# block (``` or ~~~, opener indented up to 3 spaces, closer needs no trailing
# text besides whitespace and at least as many fence characters as the
# opener). Sets LOC_OK (1 if there is no block, or exactly one well-formed
# one, outside any fence), LOC_BEGIN/LOC_END (line numbers, empty if there is
# no block), LOC_CRLF (1 if the begin marker line ends in \r) and LOC_REASON
# (set when LOC_OK is 0, naming the line numbers involved).
instructions_locate() {
  local file=$1 out
  LOC_OK=1 LOC_BEGIN="" LOC_END="" LOC_CRLF=0 LOC_REASON=""
  [[ -f $file ]] || return 0
  out=$(awk -v begin="$instr_begin" -v end="$instr_end" -v cr="$instr_cr" '
    function rstrip(s) {
      sub(/[ \t]+$/, "", s)
      sub(cr "+$", "", s)
      sub(/[ \t]+$/, "", s)
      return s
    }
    BEGIN { infence=0; fchar=""; flen=0; fopen=0; nb=0; ne=0; bl=""; el=""; firstb=0; firste=0; crlf=0 }
    {
      line = $0
      if (match(line, /^ ? ? ?(```+|~~~+)/)) {
        run = substr(line, RSTART, RLENGTH)
        rest = substr(line, RSTART + RLENGTH)
        gsub(/^ ? ? ?/, "", run)
        ch = substr(run, 1, 1)
        len = length(run)
        if (!infence) { infence = 1; fchar = ch; flen = len; fopen = NR }
        else if (ch == fchar && len >= flen && rstrip(rest) == "") { infence = 0 }
        next
      }
      if (infence) next
      s = rstrip(line)
      if (s == begin) {
        nb++
        if (nb == 1) { firstb = NR; crlf = (substr(line, length(line), 1) == cr) ? 1 : 0 }
        bl = (bl == "" ? NR : bl "," NR)
      } else if (s == end) {
        ne++
        if (ne == 1) firste = NR
        el = (el == "" ? NR : el "," NR)
      }
    }
    END {
      if (infence) {
        print "ok|0"; print "begin|"; print "end|"; print "crlf|0"
        print "reason|unterminated code fence (opened at line " fopen ")"
        exit
      }
      if (nb == 0 && ne == 0) { print "ok|1"; print "begin|"; print "end|"; print "crlf|0"; print "reason|"; exit }
      if (nb == 1 && ne == 1 && firstb < firste) { print "ok|1"; print "begin|" firstb; print "end|" firste; print "crlf|" crlf; print "reason|"; exit }
      reason = ""
      if (nb >= 2) reason = "more than one begin marker (lines " bl ")"
      else if (ne >= 2) reason = "more than one end marker (lines " el ")"
      else if (nb == 1 && ne == 1) reason = "end marker (line " firste ") before begin marker (line " firstb ")"
      else if (nb == 1 && ne == 0) reason = "begin marker (line " firstb ") with no matching end marker"
      else if (nb == 0 && ne == 1) reason = "end marker (line " firste ") with no matching begin marker"
      print "ok|0"; print "begin|" firstb; print "end|" firste; print "crlf|0"; print "reason|" reason
    }
  ' "$file")
  local key val
  while IFS='|' read -r key val; do
    case $key in
      ok) LOC_OK=$val ;;
      begin) LOC_BEGIN=$val ;;
      end) LOC_END=$val ;;
      crlf) LOC_CRLF=$val ;;
      reason) LOC_REASON=$val ;;
    esac
  done <<< "$out"
}

# True if $1 (one line of text, no newline) is blank: empty, or only spaces,
# tabs and/or \r (an LF or CRLF blank line).
instructions_blank_line() {
  local s=$1
  while [[ $s == *[$' \t'"$instr_cr"] ]]; do s=${s%?}; done
  [[ -z $s ]]
}

# Renders $1 (instructions_block()'s output, LF-separated, no trailing
# newline) with CRLF line endings when $2 is 1. Sets INSTR_RENDERED and
# INSTR_EOL (the line terminator to put after it).
instructions_render() {
  INSTR_RENDERED=$1; INSTR_EOL=$'\n'
  if [[ $2 == 1 ]]; then
    INSTR_RENDERED=${1//$'\n'/$'\r\n'}; INSTR_EOL=$'\r\n'
  fi
}

# 0666 masked by the current umask: what a plain file creation would get.
# mktemp always creates its file at 0600 regardless of umask, so a brand new
# CLAUDE.md/AGENTS.md needs this instead of a mode that ignores umask.
instructions_new_file_mode() {
  local m; m=$(umask)
  printf '%o' $(( 0666 & ~(0${m}) & 0777 ))
}

# Creates a temp file next to $1 (same directory, so instructions_commit's mv
# stays on one filesystem and is atomic) and gives it $1's mode if $1 exists,
# else umask-masked 0666. Sets INSTR_TMP, truncated and ready for the caller
# to append to, and arms a cleanup trap so a die before the matching
# instructions_commit never leaves a stray temp file behind. Seeding the mode
# is not best-effort: a silently-ignored failure here would leave the temp
# file at mktemp's 0600 and, once committed, silently tighten $1's mode.
instructions_new_tmp() {
  local real=$1 dir
  dir=$(dirname "$real")
  INSTR_TMP=$(mktemp "$dir/.repo-intel-instructions.XXXXXX") || die "$real: could not create a temp file in $dir"
  trap 'rm -f "$INSTR_TMP"' EXIT
  if [[ -f $real ]]; then
    cp -p "$real" "$INSTR_TMP" || die "$real: could not copy its mode to the temp file"
  else
    chmod "$(instructions_new_file_mode)" "$INSTR_TMP" || die "could not set the new file's mode"
  fi
  : > "$INSTR_TMP"
}

# Atomically replaces $1 with the content built in INSTR_TMP (see
# instructions_new_tmp): mv is a rename on one filesystem, so $1 is either
# the old content or the new content, never half of either, even if an
# earlier write in this process failed or the disk filled up building it.
instructions_commit() {
  mv -f "$INSTR_TMP" "$1" || die "$1: could not replace the file"
  trap - EXIT
}

# Adds, updates or removes the repo-intel managed block in $file, keeping
# every other byte of the file untouched. Never reads the file's content into
# a shell variable: command substitution truncates at the first NUL byte, so
# all copying goes file-to-file via sed/cat, and "unchanged" is decided by
# cmp against the candidate output, not by comparing strings. $block is the
# new block text (instructions_block()'s output, no trailing newline), or
# empty to remove the block. Sets ISTATUS to
# added/updated/unchanged/removed/"no graph found". Callers are expected to
# have already validated the file (instructions_check_target) and its
# structure (instructions_locate, LOC_OK) before calling this; it repeats
# both checks so it is still safe to call on its own.
instructions_apply() {
  local file=$1 block=$2 reason=$3

  instructions_check_target "$file"
  instructions_locate "$file"
  [[ $LOC_OK == 1 ]] || die "$file: $LOC_REASON"
  local ln_begin=$LOC_BEGIN ln_end=$LOC_END crlf=$LOC_CRLF

  if [[ -z $block ]]; then
    if [[ -z $ln_begin ]]; then
      ISTATUS="unchanged"; [[ $reason == nograph ]] && ISTATUS="no graph found"
      return 0
    fi
    # Drop the one blank line add would have inserted as a separator: add
    # always writes exactly one, so it is safe to drop unconditionally here.
    local pre_count=$((ln_begin - 1))
    if [[ $pre_count -gt 0 ]] && instructions_blank_line "$(sed -n "${pre_count}p" "$file")"; then
      pre_count=$((pre_count - 1))
    fi
    instructions_new_tmp "$file"
    [[ $pre_count -gt 0 ]] && sed -n "1,${pre_count}p" "$file" >> "$INSTR_TMP"
    sed -n "$((ln_end + 1)),\$p" "$file" >> "$INSTR_TMP"
    instructions_commit "$file"
    ISTATUS="removed"
    return 0
  fi

  if [[ -z $ln_begin ]]; then
    local eol_count=0
    if [[ -s $file ]]; then
      [[ $(sed -n '1p' "$file" | tail -c1) == "$instr_cr" ]] && eol_count=1
    fi
    instructions_render "$block" "$eol_count"
    instructions_new_tmp "$file"
    if [[ -s $file ]]; then
      cat "$file" >> "$INSTR_TMP"
      # Terminate an unterminated last line, then always add exactly one
      # blank-line separator (even if the file already ends in one): add and
      # remove must be exact inverses, and a conditional separator cannot be
      # told apart from a pre-existing blank line once it is written.
      [[ "$(tail -c1 "$file" | wc -l | tr -d ' ')" == 1 ]] || printf '%s' "$INSTR_EOL" >> "$INSTR_TMP"
      printf '%s' "$INSTR_EOL" >> "$INSTR_TMP"
    fi
    printf '%s%s' "$INSTR_RENDERED" "$INSTR_EOL" >> "$INSTR_TMP"
    instructions_commit "$file"
    ISTATUS="added"
    return 0
  fi

  instructions_render "$block" "$crlf"
  instructions_new_tmp "$file"
  [[ $((ln_begin - 1)) -gt 0 ]] && sed -n "1,$((ln_begin - 1))p" "$file" >> "$INSTR_TMP"
  printf '%s%s' "$INSTR_RENDERED" "$INSTR_EOL" >> "$INSTR_TMP"
  sed -n "$((ln_end + 1)),\$p" "$file" >> "$INSTR_TMP"
  if cmp -s "$INSTR_TMP" "$file"; then
    ISTATUS="unchanged"; rm -f "$INSTR_TMP"; trap - EXIT; return 0
  fi
  instructions_commit "$file"
  ISTATUS="updated"
}

# Computes the doctor-facing status of the managed block for $2/$3
# (has_codegraph/has_graphify) at repo root $1: present, missing, n/a (no
# graph yet) or invalid (<reason>). Never dies; a bad symlink or a malformed
# block is reported, not fatal, since doctor only reads. Sets INSTR_STATUS.
instructions_status() {
  local root=$1 has_cg=$2 has_gf=$3
  instructions_resolve "$root"
  if [[ -n $INSTR_CLAUDE_ERR ]]; then
    INSTR_STATUS="invalid (${INSTR_CLAUDE_ERR#*: })"; return
  fi
  if [[ $INSTR_SHARED == 0 && -n $INSTR_AGENTS_ERR ]]; then
    INSTR_STATUS="invalid (${INSTR_AGENTS_ERR#*: })"; return
  fi
  if instructions_hardlinked "$INSTR_CLAUDE"; then
    INSTR_STATUS="invalid (hardlinked file)"; return
  fi
  if [[ $INSTR_SHARED == 0 ]] && instructions_hardlinked "$INSTR_AGENTS"; then
    INSTR_STATUS="invalid (hardlinked file)"; return
  fi

  instructions_locate "$INSTR_CLAUDE"
  local c_ok=$LOC_OK c_begin=$LOC_BEGIN c_reason=$LOC_REASON a_ok=1 a_begin="" a_reason=""
  if [[ $INSTR_SHARED == 1 ]]; then
    a_ok=$c_ok; a_begin=$c_begin
  else
    instructions_locate "$INSTR_AGENTS"
    a_ok=$LOC_OK; a_begin=$LOC_BEGIN; a_reason=$LOC_REASON
  fi

  if [[ $c_ok == 0 ]]; then INSTR_STATUS="invalid ($c_reason)"
  elif [[ $a_ok == 0 ]]; then INSTR_STATUS="invalid ($a_reason)"
  elif [[ -n $c_begin ]] && { [[ $INSTR_SHARED == 1 ]] || [[ -n $a_begin ]]; }; then INSTR_STATUS="present"
  elif [[ $has_cg == 0 && $has_gf == 0 ]]; then INSTR_STATUS="n/a (no graph yet)"
  else INSTR_STATUS="missing (run: repo-intel instructions)"
  fi
}

cmd_instructions() {
  local remove=0 root has_cg=0 has_gf=0 block="" reason=normal arg
  for arg in "$@"; do
    case $arg in
      --remove) remove=1 ;;
      *) die "instructions: unknown option: $arg" ;;
    esac
  done
  root=$(repo_root)
  [[ -d $root/.codegraph ]] && has_cg=1
  [[ -f $root/graphify-out/graph.json ]] && has_gf=1

  if [[ $remove == 0 ]]; then
    if [[ $has_cg == 1 || $has_gf == 1 ]]; then
      block=$(instructions_block "$has_cg" "$has_gf")
    else
      reason=nograph
    fi
  fi

  # Validate both targets (symlink safety, file type/permissions, existing
  # block structure) before writing either one: on any doubt, die here, not
  # partway through.
  instructions_resolve "$root"
  [[ -z $INSTR_CLAUDE_ERR ]] || die "$INSTR_CLAUDE_ERR"
  [[ $INSTR_SHARED == 1 || -z $INSTR_AGENTS_ERR ]] || die "$INSTR_AGENTS_ERR"

  instructions_check_target "$INSTR_CLAUDE"
  instructions_locate "$INSTR_CLAUDE"
  [[ $LOC_OK == 1 ]] || die "$INSTR_CLAUDE: $LOC_REASON"
  if [[ $INSTR_SHARED == 0 ]]; then
    instructions_check_target "$INSTR_AGENTS"
    instructions_locate "$INSTR_AGENTS"
    [[ $LOC_OK == 1 ]] || die "$INSTR_AGENTS: $LOC_REASON"
  fi

  if [[ $INSTR_SHARED == 1 ]]; then
    instructions_apply "$INSTR_CLAUDE" "$block" "$reason"
    info "CLAUDE.md, AGENTS.md (same file): $ISTATUS"
  else
    instructions_apply "$INSTR_CLAUDE" "$block" "$reason"
    info "CLAUDE.md: $ISTATUS"
    instructions_apply "$INSTR_AGENTS" "$block" "$reason"
    info "AGENTS.md: $ISTATUS"
  fi
}

case ${1:-help} in
  help|-h|--help) usage; exit 0 ;;
  install) ;;
  *) have jq || die "jq is required" ;;
esac
cmd=${1:-help}; shift || true
case $cmd in
  doctor) cmd_doctor "$@" ;;
  install) cmd_install "$@" ;;
  setup) cmd_setup "$@" ;;
  config) cmd_config "$@" ;;
  build) cmd_build "$@" ;;
  instructions) cmd_instructions "$@" ;;
  migrate-hooks) cmd_migrate_hooks "$@" ;;
  *) usage; exit 1 ;;
esac
